{
  "name": "@mediact/react",
  "version": "1.1.34",
  "description": "React components for Mediact Design System (Tailwind v4 + Radix)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "style.css",
    "README.md",
    "AI-CHAT.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./ai-chat": {
      "types": "./dist/ai-chat/index.d.ts",
      "import": "./dist/ai-chat/index.js"
    },
    "./ai-chat.css": "./dist/ai-chat/style.css",
    "./mui": {
      "types": "./dist/mui/index.d.ts",
      "import": "./dist/mui/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme/portal.css": "./dist/theme/portal.css",
    "./theme/mediwork.css": "./dist/theme/mediwork.css",
    "./theme/medimatch.css": "./dist/theme/medimatch.css",
    "./theme/medihr.css": "./dist/theme/medihr.css",
    "./theme/medipay.css": "./dist/theme/medipay.css",
    "./theme/medirefer.css": "./dist/theme/medirefer.css",
    "./theme/medioncloud.css": "./dist/theme/medioncloud.css",
    "./assets/*": "./assets/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "node scripts/lint-colors.mjs",
    "lint:colors": "node scripts/lint-colors.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "keycloak-js": "^26.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sonner": "^2.0.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "centrifuge": "^5.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.7",
    "react-number-format": "^5.4.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "keycloak-js": "^26.2.0",
    "playwright": "^1.59.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependenciesMeta": {
    "keycloak-js": {
      "optional": true
    }
  }
}
